# --- Application ---
APP_URL=http://localhost:8080
APP_ENV=local
# 32 random bytes, base64-encoded. Generate: php -r "echo base64_encode(random_bytes(32));"
APP_ENCRYPTION_KEY=

# --- Database (XAMPP MariaDB defaults) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=belive_eve
DB_USER=root
DB_PASS=

# --- Admin login (single account, competition scope) ---
ADMIN_USERNAME=admin
# Generate: php -r "echo password_hash('yourpassword', PASSWORD_BCRYPT);"
ADMIN_PASSWORD_HASH=admin123

# --- WhatsApp Cloud API webhook ---
# Any random string; must match the Verify Token entered in the Meta App dashboard.
WA_VERIFY_TOKEN=

# --- Local testing ONLY ---
# When true, ModelRouter returns a clearly-labelled offline stub instead of a real
# LLM client so pipelines can be exercised without API keys. NEVER enable for the
# judge demo — the demo must run on real models.
MOCK_AI=false

# --- Phase 9 portals ---
# Owner portal access code (competition-scope shared code)
OWNER_PORTAL_CODE=

# Eve's WhatsApp number for portal CTAs (digits only). Empty = BeLive wa.link fallback.
EVE_WA_NUMBER=

# --- Promo video rendering (Content studio → 🎬 Promo video) ---
# ffmpeg renders the room's own photos and tour clips into a 9:16 reel. Leave
# blank when ffmpeg is on PATH; otherwise give the full path to the executable.
# Without it the studio simply hides the video option — captions are unaffected.
FFMPEG_BIN=
# TrueType fonts for the burned-in on-screen text. Blank auto-detects the usual
# Windows/Linux/macOS locations (Arial, DejaVu, Liberation).
PROMO_FONT_BOLD=
PROMO_FONT_REGULAR=

# --- Outside scheduler for the daily content run ---
# Any random string. Set it and GET /cron/auto_draft?token=<this> runs the day's
# drafting if it is owed — the way to keep the schedule ticking on a day when no
# admin opens the panel (App Service Linux has no crontab). Leave blank and the
# endpoint 404s; the panel's own tick and Run now button still work.
# Generate: php -r "echo bin2hex(random_bytes(16));"
CRON_TOKEN=
